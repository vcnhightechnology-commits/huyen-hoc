  "clauses": [
    {
      "id": "weather-role",
      "pdfPages": [
        2,
        3
      ],
      "boundedParaphrase": "天時中父雨財晴、兄風雲、子日月、官雷電等屬傳統取象，須按問晴雨及動靜時令，不是現代氣象效度證明。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "weather-sequence",
      "pdfPages": [
        4,
        5
      ],
      "boundedParaphrase": "先後動變、入墓、休囚生扶與三合等另有條件，不能把父現即雨/財現即晴當定論。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "weather-timing",
      "pdfPages": [
        6,
        7,
        8
      ],
      "boundedParaphrase": "候合/候沖、動靜旬空、月破、墓與自化入墓、原神伏藏均分開；本次只編四種目標支座標。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "rain-turn",
      "pdfPages": [
        8
      ],
      "boundedParaphrase": "雨宜兼察財爻及財伏不伏、原神與轉爻，不能把晴雨問題的選用直接推廣到所有占問。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "annual-scale",
      "pdfPages": [
        8,
        9
      ],
      "boundedParaphrase": "年時談國家人物與年尺度，太歲、五六爻等位置取象不等於日常個人流年引擎。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "annual-narrative",
      "pdfPages": [
        10,
        11,
        12
      ],
      "boundedParaphrase": "國家災異、地震、刑害、神獸及史例為歷史文本，沒有獨立驗證事件或風險機率。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "territory",
      "pdfPages": [
        12
      ],
      "boundedParaphrase": "地支分野以古國方域為例，不能無校勘投射成現代地理區域。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "dynastic",
      "pdfPages": [
        13,
        14,
        15,
        16
      ],
      "boundedParaphrase": "國朝以太歲/世/應及君臣等取象配史例，屬作者敘事，並非已確認的事前預測資料。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "battle",
      "pdfPages": [
        16,
        17,
        18,
        19
      ],
      "boundedParaphrase": "征戰的軍師/糧草/主客用神及史例不轉成現實戰術或勝敗預測；保留生扶/受制和角色條件作史料。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "body-framework",
      "pdfPages": [
        19,
        20
      ],
      "boundedParaphrase": "身命論世爻、身、卦宮及時令，並非八字或紫微同名概念的替代算法。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "life-support",
      "pdfPages": [
        20,
        21
      ],
      "boundedParaphrase": "身世空墓、旺衰、生扶等關係有上下文；來源的富貴貧夭說不直接輸出給使用者。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "life-horizon-quotation",
      "pdfPages": [
        22
      ],
      "boundedParaphrase": "身命段引易林補遺正互變三十年/小限等說；卷三另有批評，不把卷內引文與作者立場或跨書共識混合。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "kin-counts",
      "pdfPages": [
        23,
        24
      ],
      "boundedParaphrase": "家庭關係與五行生成數/倍減等說需按來源及生旺休囚分辨，尚未驗證人口或子女數準確率。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "changed-kin",
      "pdfPages": [
        25
      ],
      "boundedParaphrase": "化父化子、世應生合與身爻等仍依問事/親疏/位置；僅讀到25，未聲稱身命全篇完成。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    }
