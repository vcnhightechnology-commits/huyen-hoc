      "startCodepoint": 708,
      "endCodepoint": 726,
      "literalDigital": "死絶刑露痩小精神乖佼是非賤佞樂禍幸災",
      "disposition": "historical-vitality-personality",
      "predictiveEfficacyValidated": false
    },
    {
