  "records": [
    {
      "id": "P00",
      "startCodepoint": 0,
      "endCodepoint": 3,
      "literalDigital": "論三刑",
      "disposition": "heading",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P01",
      "startCodepoint": 3,
      "endCodepoint": 137,
      "literalDigital": "隂符經曰恩生於害害生於恩三刑生於二合亦如六害生於六合之義如申子辰三合加寅卯辰三位則申刑寅子刑卯辰見辰自刑寅午戍加巳午未則寅刑巳午見午自刑戍刑未巳酉丑加申酉戍則巳刑申酉見酉自刑丑刑戍亥卯未加亥子丑則亥見亥自刑卯寅子未刑丑合中生刑猶人夫婦相合而反致刑傷造化人事其理一而已矣",
      "disposition": "attribution-and-four-source-overlays",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P02",
      "startCodepoint": 137,
      "endCodepoint": 251,
      "literalDigital": "經云金剛火强自刑其方木落歸本水流趨東故巳酉丑金位其刑皆在西方寅午戍火位其刑皆在南方是金剛火强自刑其方也亥卯未木位其刑皆在北方亥者木之根言木落歸本者草木至冬而摇落歸根之謂也申子辰水位其刑皆在東方辰者水之府言水流趨東必東流逝而不返也",
      "disposition": "spatial-etiology",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P03",
      "startCodepoint": 251,
      "endCodepoint": 268,
      "literalDigital": "子卯一刑也寅巳申二刑也丑未戍三刑也",
      "disposition": "three-numbered-families",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P04",
      "startCodepoint": 268,
      "endCodepoint": 371,
      "literalDigital": "或曰三刑之法以數起之皇極中天十為煞數積數至十則畨空其數天道惡盈滿則覆故數自卯順至子子逆至卯極十數而為無禮之刑寅逆至巳巳逆至申極十數而為無恩之刑丑順至戍戍順至未極十數而為恃勢之刑七則衝十則刑六則合一理之自然也",
      "disposition": "attributed-ordinal-ten-explanation",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P05",
      "startCodepoint": 371,
      "endCodepoint": 454,
      "literalDigital": "然寅巳申何以謂之無恩葢寅中有甲木刑巳中戊土戊以癸水相合為妻則癸水者甲木之母也戊土既為癸水之夫乃甲之父也彼父而我刑之恩斯忘矣巳中之丙刑申中之庚申中之庚刑寅中之甲准此同義",
      "disposition": "primary-無恩-hidden-stem-analogy",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P06",
      "startCodepoint": 454,
      "endCodepoint": 499,
      "literalDigital": "又云寅有生火刑巳上生金巳上寄生之土刑申上長生之水申中生水刑寅中生火不恤所生遥相尅制做曰無恩",
      "disposition": "alternate-life-stage-analogy",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P07",
      "startCodepoint": 499,
      "endCodepoint": 519,
      "literalDigital": "生旺主人持重少語寡慾無情多招失義忘恩之撓",
      "disposition": "historical-vitality-personality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P08",
      "startCodepoint": 519,
      "endCodepoint": 530,
      "literalDigital": "死絶則面譽背毁忘恩失義",
      "disposition": "historical-vitality-personality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P09",
      "startCodepoint": 530,
      "endCodepoint": 542,
      "literalDigital": "入貴格則𢡖虐好殺好立功業",
      "disposition": "historical-status-personality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P10",
      "startCodepoint": 542,
      "endCodepoint": 554,
      "literalDigital": "入賤格則言行乖越貪吝無厭",
      "disposition": "historical-status-personality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P11",
      "startCodepoint": 554,
      "endCodepoint": 575,
      "literalDigital": "婦人得之多産血損胎之災一生不利骨肉性頗亷正",
      "disposition": "historical-sex-health-family",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P12",
      "startCodepoint": 575,
      "endCodepoint": 648,
      "literalDigital": "丑戌未何以謂之恃勢葢丑中有旺水丑乃水中之土戌中有墓火丑恃旺水刑戌中之墓火戌為六甲之尊未為六癸之卑戌恃六甲之尊刑未六癸之卑未有旺土復恃勢刑丑中之旺水",
      "disposition": "primary-恃勢-water-fire-analogy",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "P13",
      "startCodepoint": 648,
      "endCodepoint": 690,
      "literalDigital": "又云未恃丁火之勢以刑丑中之金丑恃旺水之勢以刑戌中之火戌恃辛金之勢以刑未中之木故曰恃勢",
      "disposition": "alternate-hidden-stem-analogy",
      "predictiveEfficacyValidated": false
    },
    {
