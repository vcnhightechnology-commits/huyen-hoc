  "records": [
    {
      "id": "C00",
      "literalDigital": "論衝擊(對靣相衝之氣謂之一七煞者是也/)",
      "disposition": "heading-and-gloss",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C01",
      "literalDigital": "地支取七位為衝猶天干取七位為煞之義如子午對衝子至午七數甲逄庚為煞甲至庚七數",
      "disposition": "ordinal-seven-branch-and-甲庚-example",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C02",
      "literalDigital": "數中六則合七則過故相衝擊為煞也觀易坤元用六其數有六無七七乃天地之窮數隂陽之極氣也今書皂字從七木此葢色至於皂色之極矣不可變矣易曰七日來復勿逐七日得是也",
      "disposition": "numerological-etiology",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C03",
      "literalDigital": "相衝者十二支戰擊之神大槩為凶然有為福之甚者",
      "disposition": "general-adverse-wording-with-exception",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C04",
      "literalDigital": "乃衝處相生如辛巳金見癸亥水之類主聲望播流髙明出衆科甲崢嶸",
      "disposition": "辛巳癸亥-literal-and-historical-status",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C05",
      "literalDigital": "若衝處相尅如壬申金見庚寅才之類主人神清貌俊襟韻脱俗軒昂酒落上視仰靣而行",
      "disposition": "壬申庚寅-literal-and-historical-status",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C06",
      "literalDigital": "若生旺主人神剛貌肅膽氣壮倜儻敢為多成敗",
      "disposition": "historical-vitality-personality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C07",
      "literalDigital": "死絶則寒酸鄙薄刑容乖劣動招凶辱多夭折",
      "disposition": "historical-vitality-mortality",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C08",
      "literalDigital": "若戌丑未未四庫所藏為十干財官印綬等物尤喜衝激",
      "disposition": "unresolved-repeated未-four-storehouses",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C09",
      "literalDigital": "若寅申巳亥全子午卯酉全反成大格不以衝擊論",
      "disposition": "two-distinct-four-branch-completeness",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C10",
      "literalDigital": "若同類相衝如甲子見甲午己卯見己酉之類主多破祖業平生心不閑剛明有斷假令禄髙名重終有一失",
      "disposition": "two-same-stem-literal-examples",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C11",
      "literalDigital": "又曰凡遇一七煞命吉則衝發命凶則為禍",
      "disposition": "declared命吉命凶context",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "C12",
      "literalDigital": "如禍聚之地有他位来衝謂之破禍成福",
