  "records": [
    {
      "id": "J00",
      "startCodepoint": 0,
      "endCodepointExclusive": 90,
      "literalDigital": "論將星華葢(二煞皆三合中取故附於後/)将星者如将劄中軍也故以三合中位謂之将星華葢者喻如寳葢天有此星其形如葢常覆乎大帝之座故以三合底處得庫謂之華葢洞𤣥經云将星處乎中軍華葢張乎庫土是也",
      "disposition": "selected-general-middle-and-canopy-store-role-definitions",
      "wholeUnitApplied": false
    },
    {
      "id": "J01",
      "startCodepoint": 90,
      "endCodepointExclusive": 107,
      "literalDigital": "凡将星常欲吉星相扶貴煞加臨乃為吉慶",
      "disposition": "declared-benefic-support-and-noble-marker-not-classified",
      "wholeUnitApplied": false
