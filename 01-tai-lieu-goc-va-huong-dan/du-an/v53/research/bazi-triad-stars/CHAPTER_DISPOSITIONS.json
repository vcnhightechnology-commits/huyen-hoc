    {
      "id": "J02",
      "startCodepoint": 107,
      "endCodepointExclusive": 129,
      "literalDigital": "理愚歌云將星若用亡神臨為國棟梁臣言吉助之為貴",
      "disposition": "nested-attribution-亡神-with吉助-not-unconditional-cancellation",
      "wholeUnitApplied": false
    },
    {
      "id": "J03",
      "startCodepoint": 129,
      "endCodepointExclusive": 147,
      "literalDigital": "更夾貴庫墓純粹而不雜者出将入相之格也",
      "disposition": "unmixed-store-premise-and-historical-office-claim",
      "wholeUnitApplied": false
    },
    {
      "id": "J04",
      "startCodepoint": 147,
      "endCodepointExclusive": 161,
      "literalDigital": "帶華葢正印而不夾庫兩府之格也",
      "disposition": "positive-and-negative-premises-no-modern-office-prediction",
      "wholeUnitApplied": false
    },
    {
      "id": "J05",
      "startCodepoint": 161,
      "endCodepointExclusive": 174,
      "literalDigital": "只帶庫墓而不帶正印員郎以上",
      "disposition": "positive-and-negative-premises-no-modern-office-prediction",
      "wholeUnitApplied": false
    },
    {
      "id": "J06",
      "startCodepoint": 174,
      "endCodepointExclusive": 192,
      "literalDigital": "既不帶墓又不𢃄正印止有華葢常調之禄也",
      "disposition": "three-absence-presence-premises-no-numeric-rank-model",
      "wholeUnitApplied": false
    },
    {
      "id": "J07",
      "startCodepoint": 192,
      "endCodepointExclusive": 209,
      "literalDigital": "𢃄華印而正建驛馬名曰節印主旌節之貴",
      "disposition": "named-marker-conjunction-no-automatic-calendar-adapter",
      "wholeUnitApplied": false
    },
    {
      "id": "J08",
      "startCodepoint": 209,
      "endCodepointExclusive": 222,
      "literalDigital": "若嵗干庫同庫為兩重福主大貴",
      "disposition": "year-stem-store-frame-not-replaced-with-day-stem",
      "wholeUnitApplied": false
    },
    {
      "id": "J09",
      "startCodepoint": 222,
      "endCodepointExclusive": 247,
      "literalDigital": "又曰凡人命得華葢多主孤寡總貴亦不免孤獨作僧道藝術論",
