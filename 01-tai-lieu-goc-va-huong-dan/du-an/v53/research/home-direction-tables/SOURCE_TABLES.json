  "nextSourceClauses": [
    {
      "id": "D54-01",
      "page": 54,
      "text": "立春艮雨水寅驚蟄甲春分震清明乙穀雨辰立夏巽小滿巳芒種丙夏至離小暑丁大暑未立秋坤處暑申白露庚秋分兌寒露辛霜降戌立冬乾小雪亥大雪壬冬至坎小寒癸大寒丑",
      "disposition": "All24 term-to-coordinate labels corroborate diagram53; glyph aliases declared separately."
    },
    {
      "id": "D54-02",
      "page": 54,
      "text": "四立二分二至正應八卦是為八節奇門九局皆起于此",
      "disposition": "Eight named terms link to eight gua; do not infer a full Qimen cycle algorithm."
    },
    {
      "id": "D56-01",
      "page": 56,
      "text": "乾納甲坎納癸申辰艮納丙震納庚亥未巽納辛離納壬寅戌坤納乙兌納丁巳丑",
      "disposition": "Eight groups include24 geographical coordinates; not per-line divination NaJia."
    },
    {
      "id": "D56-02",
      "page": 56,
      "text": "坎離不納戊己者二十四山無戊己故離納乾之壬坎納坤之癸其法不知所自來",
      "disposition": "Retain explicit source criticism: origin unknown. No modern adoption inferred."
    },
    {
      "id": "D56-03",
      "page": 56,
      "text": "今按啓蒙附論曰火之體陰也其用則陽而天用之故乾中畫與坤交而變為離水之體陽也其用則陰而地用之故坤中畫與乾交而變為坎",
      "disposition": "Named quotation/trigram structural rationale; do not treat as observed fire/water physics."
    },
    {
      "id": "D56-04",
      "page": 56,
      "text": "然則坎離納戊己者固先天之傳而離納壬坎納癸則後天之用也",
      "disposition": "Keep claimed earlier/later conceptual justification distinct; no chronology independently verified."
    },
    {
      "id": "D56-05",
      "page": 56,
      "text": "其四正卦兼納八支取與本卦支為三合局地理家之坐山",
      "continuesOnPage": 57,
      "disposition": "Four cardinal gua take8 additional branches as triads."
    },
    {
      "id": "D57-01",
      "page": 57,
      "text": "九星淨陰淨陽皆起于此",
      "continuesFromPage": 56,
      "disposition": "Claimed later use recorded only; no nine-star/net-yin-yang procedure from this clause."
    }
