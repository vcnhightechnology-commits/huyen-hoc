  "records": [
    {
      "id": "H00",
      "startCodepoint": 0,
      "endCodepoint": 3,
      "literalDigital": "論六害",
      "disposition": "heading",
      "implementedAs": "source-record-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H01",
      "startCodepoint": 3,
      "endCodepoint": 43,
      "literalDigital": "因晝夜隂陽之氣感而六合因六合而生六害因六害而忌晝夜隂陽之氣六害者十二支凌戰之辰也",
      "disposition": "etiological-preface",
      "implementedAs": "source-record-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H02",
      "startCodepoint": 43,
      "endCodepoint": 68,
      "literalDigital": "子未相害者謂未旺土亥子旺水名勢家相害故子見未則為害",
      "disposition": "pair-definition",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H03",
      "startCodepoint": 68,
      "endCodepoint": 105,
      "literalDigital": "丑午相害者謂午以旺火凌丑死金名官鬼相害故丑見午而午更帶丑干之真鬼則為害尢甚",
      "disposition": "pair-and-open-true-ghost-condition",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H04",
      "startCodepoint": 105,
      "endCodepoint": 146,
      "literalDigital": "寅巳相害者謂各恃臨官擅能而進相害若干神往来有鬼者尢甚况刑在其中尢不可不加减災福言之",
      "disposition": "pair-and-open-ghost-penalty-condition",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H05",
      "startCodepoint": 146,
      "endCodepoint": 184,
      "literalDigital": "卯辰相害者謂卯以旺木凌辰死土此以少淩長相害故辰見卯而卯更帶辰干真鬼則其害尢甚",
      "disposition": "pair-and-open-true-ghost-condition",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H06",
      "startCodepoint": 184,
      "endCodepoint": 219,
      "literalDigital": "申亥相害者謂各恃臨官競嫉才能爭進相害故申見亥亥見申均為害更納音相尅者重",
      "disposition": "bidirectional-pair-and-nayin-condition",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H07",
      "startCodepoint": 219,
      "endCodepoint": 270,
      "literalDigital": "酉戍相害者謂戍以死火害酉旺金此嫉妬相害故酉人見戍則㓙戍人見酉無災若乙酉人得戊戌乙為真金戊為真火為害尢甚",
      "disposition": "directional-exception-and-literal-example",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H08",
      "startCodepoint": 270,
      "endCodepoint": 291,
      "literalDigital": "又云六六親害損也犯之主六親上有損尅故謂六害",
      "disposition": "historical-kin-outcome",
      "implementedAs": "source-record-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H09",
      "startCodepoint": 291,
      "endCodepoint": 371,
      "literalDigital": "子未直上穿心與衝合恩未結而讐巳生乃曰害如子生人畏午衝而未却去合午丑畏未衝而午却去合未寅畏申衝而巳合申卯畏酉衝而辰合酉申畏寅衝而亥合寅酉畏卯衝而戍合卯所以皆為害也",
      "disposition": "causal-explanation-six-rows",
      "implementedAs": "source-coordinate-or-declared-premise-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H10",
      "startCodepoint": 371,
      "endCodepoint": 387,
      "literalDigital": "凡人𢃄此再見羊刃刼煞官符為災尢甚",
      "disposition": "open-additional-star-condition",
      "implementedAs": "source-record-only",
      "predictiveEfficacyValidated": false
    },
    {
      "id": "H11",
