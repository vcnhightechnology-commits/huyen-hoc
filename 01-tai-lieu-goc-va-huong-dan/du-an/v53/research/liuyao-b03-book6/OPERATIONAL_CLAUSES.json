      "pdfPages": [
        53,
        54,
        55,
        56,
        57
      ],
      "boundedParaphrase": "獨發、獨靜及暗動需分；僅一爻明動不代表所有問事都可捨用神。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
