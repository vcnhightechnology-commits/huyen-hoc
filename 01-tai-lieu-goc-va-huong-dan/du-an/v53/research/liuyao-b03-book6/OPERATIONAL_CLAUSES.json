      "pdfPages": [
        57,
        58,
        59
      ],
      "boundedParaphrase": "盡靜盡發仍分日沖/用神/強弱；整齊動靜不單獨代表吉凶。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
