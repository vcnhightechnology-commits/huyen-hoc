  "clauses": [
    {
      "id": "three-transmissions",
      "pdfPages": [
        2,
        3,
        4
      ],
      "boundedParaphrase": "年/月/日與動變生剋需分層；書例不是無條件規則。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "return-control",
      "pdfPages": [
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "boundedParaphrase": "爻變回剋、卦變回剋及原用二神的例外分開；不把一個變支跨位剋所有爻。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "original-support",
      "pdfPages": [
        9,
        10,
        11
      ],
      "boundedParaphrase": "生用爻先作原神候選；原神動而變剋、退絕墓破及日月制約仍可失去生用前提，非見生即救。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "triad",
      "pdfPages": [
        11,
        12,
        13,
        14,
        15,
        16,
        17
      ],
      "boundedParaphrase": "三合局受原/用/忌角色、動靜、空破和成局時點限制；完整成員不等於效力。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "fanyin",
      "pdfPages": [
        17,
        18,
        19
      ],
      "boundedParaphrase": "反吟有爻/卦變和用神受沖剋程度；保留反覆與例外，不給固定凶分。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "fuyin",
      "pdfPages": [
        19,
        20,
        21
      ],
      "boundedParaphrase": "伏吟與用神、內外及對象相連；靜態坐標不自動推結果。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "void",
      "pdfPages": [
        21,
        22,
        23,
        24,
        25,
        26,
        27,
        28
      ],
      "boundedParaphrase": "旬空分無生受剋/有生待時；出旬、值日、填實、沖起等須各自前提。近病/久病等歷史生死語不作臨床推斷。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "monthbreak",
      "pdfPages": [
        28,
        29,
        30,
        31
      ],
      "boundedParaphrase": "月破有動靜、生扶和出破、填實、合破的條件；不以單一對沖剔除所有用神。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "hidden",
      "pdfPages": [
        31,
        32,
        33,
        34
      ],
      "boundedParaphrase": "伏神得出與不得出各列四端；不把純宮伏位存在當成有效用神已出。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "advance-retreat",
      "pdfPages": [
        35,
        36,
        37
      ],
      "boundedParaphrase": "進退分旺相乘勢/待時/空破待補等；本支與自變支的八對只完成坐標層。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "event-order",
      "pdfPages": [
        37,
        38,
        39,
        40,
        41
      ],
      "boundedParaphrase": "合處逢沖與沖中逢合涉及先後/當下機括；同時存在沖合不自推順序。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "phases",
      "pdfPages": [
        41,
        42,
        43,
        44,
        45,
        46,
        47
      ],
      "boundedParaphrase": "生墓絕可由日辰、飛爻、動變形成；不能混為同一層或同一強度。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "figure-relations",
      "pdfPages": [
        47,
        48,
        49,
        50,
        51,
        52
      ],
      "boundedParaphrase": "六沖六合和其變化有對象、用神與日月等例外，醫療/人命敘事保持歷史。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
      "id": "punishment-harm",
      "pdfPages": [
        52,
        53
      ],
      "boundedParaphrase": "原文對三刑六害的取捨是該書立場，不算跨書共識或驗證。",
      "consumerApplied": false,
      "historicalOutcomesValidated": false
    },
    {
