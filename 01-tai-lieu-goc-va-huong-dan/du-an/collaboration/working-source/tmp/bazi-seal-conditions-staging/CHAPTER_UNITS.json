  "cleanCodepoints": 690,
  "cleaningPolicy": "Remove only pb markers, whitespace and paragraph markers; no glyph emendation.",
  "units": [
    {
      "id": "S01",
      "opening": "論正印",
      "start": 0,
      "end": 186,
      "text": "論正印正印者乃五行之正庫金命見乙丑木癸未火甲戌水土壬辰丙辰是也言談云生逢正印必拜玉堂妙選云五行入垣官居五府可見得本家正印為貴本主同徳為上帝座為中胎月為下主人重厚魁梧功名昭著本家印又得貴格扶之更妙若木得水印火得木印多兼他權外財若身尅印或印尅身廢而復興若水人得火印火人帶水印次於本家印然須本主有旺氣方吉若尅破别無福救助或空亡只作清閒僧道無成舉人若五行有清氣則絶世高人有煞則貧賤",
      "wholeUnitApplied": false
    },
    {
      "id": "S02",
      "opening": "有貴人夾印",
      "start": 186,
      "end": 238,
      "text": "有貴人夾印如丙丁火命以甲戌為正印却得酉亥夾之酉亥乃丙丁貴人壬癸水命以壬辰為正印却得卯巳夾之卯巳乃壬癸貴人",
      "wholeUnitApplied": false
    },
    {
      "id": "S03",
      "opening": "有華蓋印",
      "start": 238,
      "end": 251,
      "text": "有華蓋印如亥卯未得癸未之類",
      "wholeUnitApplied": false
    },
    {
      "id": "S04",
      "opening": "有文章印",
      "start": 251,
      "end": 323,
      "text": "有文章印如戊寅見癸未辛巳見甲戌庚申見乙丑癸亥見丙辰乙亥見壬辰乃納音尅身干神復制戊午得癸未庚子得乙丑丁酉得壬辰己卯得甲戌辛酉得丙辰干神制支神合之類",
      "wholeUnitApplied": false
    },
    {
      "id": "S05",
      "opening": "諸印要逢庫墓",
      "start": 323,
      "end": 405,
      "text": "諸印要逢庫墓若生旺扶助互換祿馬貴人併相合者至貴之命最忌刑衝破害三合六合上見鬼如甲戌日得癸酉時則減力水命人得本家印無益得木印損氣得土印支干有交涉者名官印無交涉者名鬼印",
      "wholeUnitApplied": false
    },
    {
      "id": "S06",
      "opening": "有年時見印",
      "start": 405,
      "end": 429,
      "text": "有年時見印名鳯凰啣印如虞尚書癸未甲寅戊午丙辰是也",
      "wholeUnitApplied": false
    },
    {
      "id": "S07",
      "opening": "又有福聚印",
      "start": 429,
      "end": 475,
      "text": "又有福聚印如年月日時胎五位俱無氣衰敗得正印偏印俱在此印上或庫或旺雖有煞神至是受制此之謂福聚印",
      "wholeUnitApplied": false
    },
    {
      "id": "S08",
      "opening": "有禍聚印",
      "start": 475,
      "end": 518,
      "text": "有禍聚印如癸巳人帶壬辰印柱多逢水俱墓於辰則癸巳受煞以巳為命巳火遇多則本命病此之謂禍聚印",
      "wholeUnitApplied": false
    },
    {
      "id": "S09",
      "opening": "有破福成禍印",
      "start": 518,
      "end": 551,
      "text": "有破福成禍印如水人得水印或月日時胎多帶土來本家印見鬼盛是謂破福成禍",
      "wholeUnitApplied": false
    },
    {
      "id": "S10",
      "opening": "有帶煞印",
      "start": 551,
      "end": 598,
      "text": "有帶煞印印中見貴煞如壬子見壬辰丙辰子至辰謂之華蓋壬人見辰為貴若印中反尅本命無福神往還名帶煞主㓙",
      "wholeUnitApplied": false
    },
    {
      "id": "S11",
      "opening": "有臨空印",
      "start": 598,
      "end": 620,
      "text": "有臨空印乃印落空亡支無六合見官貴至賤而無成也",
      "wholeUnitApplied": false
    },
    {
      "id": "S12",
      "opening": "有自刑印",
      "start": 620,
      "end": 662,
      "text": "有自刑印如庚戌人帶乙丑金人見金印固好丑戌相刑以金刑金此類不如無雖有少福亦終賤餘准此推",
      "wholeUnitApplied": false
    },
    {
      "id": "S13",
      "opening": "凡論印",
      "start": 662,
      "end": 690,
      "text": "凡論印更得眞五行與納音同氣尤妙但主少安逸不利六親難為子息",
      "wholeUnitApplied": false
    }
  ],
  "wholeChapterApplied": false
}
